{
  "name": "sazepad-industrial-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the Sazepad industrial construction template.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "css:build": "tailwindcss -i ./src/styles/main.css -o ../release/assets/css/style.min.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/main.css -o ../release/assets/css/style.min.css --watch",
    "js:build": "esbuild ./src/js/main.js --bundle --minify --format=esm --target=es2020 --outfile=../release/assets/js/main.js",
    "js:watch": "esbuild ./src/js/main.js --bundle --format=esm --target=es2020 --sourcemap --outfile=../release/assets/js/main.js --watch",
    "serve": "node ./scripts/serve.mjs ../release 5173",
    "dev": "concurrently -k -n css,js,web -c yellow,cyan,green \"npm:css:watch\" \"npm:js:watch\" \"npm:serve\"",
    "build": "npm run css:build && npm run js:build",
    "images": "node ./scripts/images.mjs",
    "format": "prettier --config ./prettier.config.mjs --write \"../release/**/*.{html,css,js,json,md}\" \"src/**/*.{css,js}\" \"*.mjs\" \"package.json\"",
    "format:check": "prettier --config ./prettier.config.mjs --check \"../release/**/*.html\" \"src/**/*.{css,js}\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:js": "eslint src/js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.5",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "4.3.5",
    "vazirmatn": "33.0.3",
    "vite": "8.3.8"
  }
}
